VITE_APP_NAME=Agent Platform
VITE_PLATFORM_API_URL=/
VITE_PLATFORM_API_RUNTIME_ENABLED=true
VITE_REQUEST_TIMEOUT_MS=30000
VITE_DEV_PORT=3000
VITE_DEV_PROXY_TARGET=http://localhost:2142
VITE_LANGGRAPH_DEBUG_URL=
# Tracing Provider: 'langfuse', 'mlflow', 'both', or 'none' (default: mlflow)
VITE_TRACING_PROVIDER=mlflow
# EvalFlow / MLflow UI Base URL
VITE_MLFLOW_BASE_URL=http://49.233.222.54:9128
# MLflow Experiment ID for traces
VITE_MLFLOW_EXPERIMENT_ID=6
# Optional custom trace URL template: e.g. {baseUrl}/#/experiments/{experimentId}/traces/{traceId}
VITE_MLFLOW_TRACE_URL_TEMPLATE=
# Langfuse configuration (optional)
VITE_LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
VITE_LANGFUSE_PROJECT_ID=
VITE_LANGFUSE_TRACE_URL_TEMPLATE=
