# Provider smoke 只在独立测试中读取凭据；服务启动不依赖模型 profile。
# 本地值从 ~/.my_best/.env 获取，禁止提交此文件中的真实密钥。
DEEPSEEK_PROXY_API_KEY=
DEEPSEEK_PROXY_DEFAULT_MODEL=
DEEPSEEK_PROXY_SUPPORTED_MODELS=
DEEPSEEK_PROXY_URL=
GPT_PROXY_API_KEY=
GPT_PROXY_DEFAULT_MODEL=
GPT_PROXY_URL=

# Local GraphHarbor persistence. Use a dedicated database and Redis DB/namespace.
DATABASE_URI=postgresql://runtime_service:change-me@127.0.0.1:5432/runtime_service
REDIS_URI=redis://127.0.0.1:6379/7
# Apply Runtime application migrations before enabling collection; history remains readable when disabled.
RUNTIME_USAGE_ENABLED=false
# Shared native-Run token cap. Requires Usage and migrated ledger; API/Worker must agree.
RUNTIME_TOKEN_BUDGET_ENABLED=false
RUNTIME_TOKEN_BUDGET_MAX_TOKENS=100000
PLATFORM_RUNTIME_DELEGATION_SECRET=local-runtime-delegation-secret-change-me-32
PLATFORM_RUNTIME_DELEGATION_ISSUER=platform-api
PLATFORM_RUNTIME_DELEGATION_AUDIENCE=runtime-service
PLATFORM_RUNTIME_MODEL_CONFIG_URL=http://127.0.0.1:2142/api/runtime/internal/model-config
GRAPHHARBOR_RUNTIME_CONTEXT_SECRET=local-runtime-context-secret-change-me-32
GRAPHHARBOR_RUNTIME_CONTEXT_ISSUER=https://runtime-service.local
GRAPHHARBOR_RUNTIME_CONTEXT_AUDIENCE=graphharbor-worker
GRAPHHARBOR_TERMINAL_WEBHOOK_ENABLED=0
GRAPHHARBOR_TERMINAL_WEBHOOK_URL=
GRAPHHARBOR_TERMINAL_WEBHOOK_KEY_ID=runtime-v1
GRAPHHARBOR_TERMINAL_WEBHOOK_SECRET=
# Trusted HTTPS CA uses SSL_CERT_FILE/SSL_CERT_DIR. Local isolated tests alone may allow HTTP.
# Worker 单次运行超时上限（秒），默认 300，复杂工程/调研任务建议 1800（30分钟）
# Worker hard timeout; unset/empty disables it. 1800 is an example, not the default.
GRAPHHARBOR_RUN_TIMEOUT_SECONDS=1800
# Model wrapup reserve before the Worker hard deadline; zero disables the reminder.
AGENT_RUN_WRAPUP_RESERVE_SECONDS=120

# R6 Thread Workspace policy; production values belong in deploy secrets/config.
GRAPHHARBOR_WORKSPACE_ROOT=/tmp/aitestlab-runtime-workspaces
RUNTIME_WORKSPACE_MAX_FILE_BYTES=10485760
RUNTIME_WORKSPACE_MAX_FILES=10000
RUNTIME_WORKSPACE_MAX_TOTAL_BYTES=1073741824
RUNTIME_WORKSPACE_TTL_SECONDS=604800

# Teaching demo: dedicated thread data and a pre-pulled Docker execution image.
RUNTIME_SHOWCASE_WORKSPACE_ROOT=.runtime/showcase
# Office reading requires the image built from deploy/Dockerfile.agent-workspace.
RUNTIME_SHOWCASE_IMAGE=python:3.13-slim

# Public image tools (credentials are supplied locally, never via Agent Context)
IMAGE_25_URL=https://wawapii.com/v1
IMAGE_25_KEY=
IMAGE_25_MODEL=gpt-image-2.5-flare
RUNTIME_IMAGE_ASSET_HOSTS=multimodal.vibelearning.top
# Vision analysis tools (supports DeepSeek official, generic VISION_*, or Doubao Ark)
# 优先级：VISION_* > DEEPSEEK_* (deepseek-flash) > DOUBAO_*
VISION_MODEL=
VISION_API_KEY=
VISION_API_BASE=
VISION_MAX_TOKENS=2048
# Or use DeepSeek directly:
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-flash
# Legacy Doubao fallback:
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-1-6-vision-250815
DOUBAO_MAX_TOKENS=2048

# OpenTelemetry/Langfuse exporter queue; queue-full drops telemetry, never blocks a Run.
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_SERVICE_NAME=runtime-service
# Optional independent OTLP HTTP trace destination. Use the full /v1/traces URL
# in OTEL_EXPORTER_OTLP_TRACES_ENDPOINT, or a base URL in OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=10

# ==============================================================================
# Agent 工具与模型调用限制配置（防死循环与长会话保护）
# 影响的代码位置：
# 1. apps/runtime-service/src/runtime_service/middlewares/model_call_timeout.py
# 2. apps/runtime-service/src/runtime_service/services/dearflow_agent/agent.py
# 3. apps/runtime-service/src/runtime_service/services/demo/showcase_demo/agent.py
# ==============================================================================
# 单次大模型（LLM）调用超时上限（秒），深度思考/长文输出建议 600（10分钟）
AGENT_MODEL_CALL_TIMEOUT_SECONDS=600

# 1 enables trusted context budgets and manual maintenance for DearFlow/Showcase.
# Configure model capacity/output budgets and deploy API + Runtime Context v5 first.
# 0 keeps the existing official DeepAgents summarizer; it does not disable summarization.
AGENT_CONTEXT_MANAGEMENT_ENABLED=0

# 单次运行（单轮 Run）允许调用的工具总上限
AGENT_TOOL_CALL_LIMIT_PER_RUN=100

# 单个会话（整条 Thread 跨多轮历史）累计允许调用的工具总上限
AGENT_TOOL_CALL_LIMIT_PER_THREAD=1000

# 【单次运行模型调用上限】单次回合（Run）内允许调用大模型（LLM）的最大次数。
# 作用：截断 Agent 单回合内部的死循环推理或失控的工具调用重试。
# 测试方法：可设为 2 或 3，发送一个需要多步工具调用的任务，即可触发“本次执行因额度限制停止”告警。
# 推荐值：生产建议 25~50（留空或未配置则默认取模式限额，如 standard 50）。
AGENT_MODEL_CALL_LIMIT_PER_RUN=50

# 【单个会话模型调用上限】整个会话（Thread / 多轮历史）累计允许调用大模型（LLM）的总次数。
# 作用：限制单一 Thread 长期膨胀消耗过量 Token，耗尽后提示用户开启新会话。
# 测试方法：可设为 3 或 5，在同一对话中连续发送多句指令，累计超限后触发“本会话累计调用额度已耗尽”并提示开启新对话。
# 推荐值：生产建议 200~500（留空或未配置则默认取模式限额，如 standard 500）。
AGENT_MODEL_CALL_LIMIT_PER_THREAD=500

# Optional invocation soft wrapup; unset/empty disables it. Must be finite and > 0.
# Example: AGENT_WRAPUP_AFTER_SECONDS=600. This is not the Worker's remaining time.
AGENT_WRAPUP_AFTER_SECONDS=
# Consecutive identical read batches: warn after 3, stop after 5. Strict 0/1; default off.
AGENT_LOOP_DETECTION_ENABLED=0
