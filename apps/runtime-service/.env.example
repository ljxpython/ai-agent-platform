# Provider smoke 只在独立测试中读取凭据；服务启动不依赖模型 profile。
# 本地值从 ~/.my_best/.env 获取，禁止提交此文件中的真实密钥。
DEEPSEEK_PROXY_API_KEY=
DEEPSEEK_PROXY_DEFAULT_MODEL=
DEEPSEEK_PROXY_SUPPORTED_MODELS=
DEEPSEEK_PROXY_URL=
GPT_PROXY_API_KEY=
GPT_PROXY_DEFAULT_MODEL=
GPT_PROXY_URL=

# Local GraphHarbor persistence. Use a dedicated database and Redis DB/namespace.
DATABASE_URI=postgresql://runtime_service:change-me@127.0.0.1:5432/runtime_service
REDIS_URI=redis://127.0.0.1:6379/7
# Apply Runtime application migrations before enabling collection; history remains readable when disabled.
RUNTIME_USAGE_ENABLED=false
# Shared native-Run token cap. Requires Usage and migrated ledger; API/Worker must agree.
RUNTIME_TOKEN_BUDGET_ENABLED=false
RUNTIME_TOKEN_BUDGET_MAX_TOKENS=100000
# Optional text protection at model boundaries. API and all Workers must share policy/secret.
# Use a dedicated secret representing at least 32 random bytes; drain Runs before rotation.
RUNTIME_PII_REDACTION_ENABLED=false
RUNTIME_PII_TOKEN_SECRET=
RUNTIME_PII_DETECTORS=email,api_key,national_id,credit_card,phone
PLATFORM_RUNTIME_DELEGATION_SECRET=local-runtime-delegation-secret-change-me-32
PLATFORM_RUNTIME_DELEGATION_ISSUER=platform-api
PLATFORM_RUNTIME_DELEGATION_AUDIENCE=runtime-service
PLATFORM_RUNTIME_MODEL_CONFIG_URL=http://127.0.0.1:2142/api/runtime/internal/model-config
GRAPHHARBOR_RUNTIME_CONTEXT_SECRET=local-runtime-context-secret-change-me-32
GRAPHHARBOR_RUNTIME_CONTEXT_ISSUER=https://runtime-service.local
GRAPHHARBOR_RUNTIME_CONTEXT_AUDIENCE=graphharbor-worker
GRAPHHARBOR_TERMINAL_WEBHOOK_ENABLED=0
GRAPHHARBOR_TERMINAL_WEBHOOK_URL=
GRAPHHARBOR_TERMINAL_WEBHOOK_KEY_ID=runtime-v1
GRAPHHARBOR_TERMINAL_WEBHOOK_SECRET=
# Trusted HTTPS CA uses SSL_CERT_FILE/SSL_CERT_DIR. Local isolated tests alone may allow HTTP.
# Worker 单次运行超时上限（秒），默认 300，复杂工程/调研任务建议 1800（30分钟）
# Worker hard timeout; unset/empty disables it. 1800 is an example, not the default.
GRAPHHARBOR_RUN_TIMEOUT_SECONDS=1800
# Model wrapup reserve before the Worker hard deadline; zero disables the reminder.
AGENT_RUN_WRAPUP_RESERVE_SECONDS=120

# R6 Thread Workspace policy; production values belong in deploy secrets/config.
GRAPHHARBOR_WORKSPACE_ROOT=/tmp/aitestlab-runtime-workspaces
RUNTIME_WORKSPACE_MAX_FILE_BYTES=10485760
RUNTIME_WORKSPACE_MAX_FILES=10000
RUNTIME_WORKSPACE_MAX_TOTAL_BYTES=1073741824
RUNTIME_WORKSPACE_TTL_SECONDS=604800

# Teaching demo: dedicated thread data and a pre-pulled Docker execution image.
RUNTIME_SHOWCASE_WORKSPACE_ROOT=.runtime/showcase
# Office reading requires the image built from deploy/Dockerfile.agent-workspace.
RUNTIME_SHOWCASE_IMAGE=python:3.13-slim

# Opt-in background commands: API/Worker share one execution domain and target.
# Local Docker requires matching daemon-host paths; remote Node owns its local mounts.
# Apply Runtime application migrations before enabling; retain the host ID during drain.
RUNTIME_BACKGROUND_TASKS_ENABLED=0
RUNTIME_EXECUTION_HOST_ID=
RUNTIME_BACKGROUND_LOG_ROOT=.runtime/background-logs

# Public image tools (credentials are supplied locally, never via Agent Context)
IMAGE_25_URL=https://wawapii.com/v1
IMAGE_25_KEY=
IMAGE_25_MODEL=gpt-image-2.5-flare
RUNTIME_IMAGE_ASSET_HOSTS=multimodal.vibelearning.top
# Vision analysis tools (supports DeepSeek official, generic VISION_*, or Doubao Ark)
# 优先级：VISION_* > DEEPSEEK_* (deepseek-flash) > DOUBAO_*
VISION_MODEL=
VISION_API_KEY=
VISION_API_BASE=
VISION_MAX_TOKENS=2048
# Or use DeepSeek directly:
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-flash
# Legacy Doubao fallback:
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-1-6-vision-250815
DOUBAO_MAX_TOKENS=2048

# OpenTelemetry/Langfuse exporter queue; queue-full drops telemetry, never blocks a Run.
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_SERVICE_NAME=runtime-service
# Optional independent OTLP HTTP trace destination. Use the full /v1/traces URL
# in OTEL_EXPORTER_OTLP_TRACES_ENDPOINT, or a base URL in OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=10

# ==============================================================================
# Agent 工具与模型调用限制配置（防死循环与长会话保护）
# 影响的代码位置：
# 1. apps/runtime-service/src/runtime_service/middlewares/model_call_timeout.py
# 2. apps/runtime-service/src/runtime_service/services/dearflow_agent/agent.py
# 3. apps/runtime-service/src/runtime_service/services/demo/showcase_demo/agent.py
# ==============================================================================
# 单次大模型（LLM）调用超时上限（秒），深度思考/长文输出建议 600（10分钟）
AGENT_MODEL_CALL_TIMEOUT_SECONDS=600

# 1 enables trusted context budgets and manual maintenance for DearFlow/Showcase.
# Configure model capacity/output budgets and deploy API + Runtime Context v5 first.
# 0 keeps the existing official DeepAgents summarizer; it does not disable summarization.
AGENT_CONTEXT_MANAGEMENT_ENABLED=0

# 单次运行（单轮 Run）允许调用的工具总上限
AGENT_TOOL_CALL_LIMIT_PER_RUN=100

# 单个会话（整条 Thread 跨多轮历史）累计允许调用的工具总上限
AGENT_TOOL_CALL_LIMIT_PER_THREAD=1000

# 【单次运行模型调用上限】单次回合（Run）内允许调用大模型（LLM）的最大次数。
# 作用：截断 Agent 单回合内部的死循环推理或失控的工具调用重试。
# 测试方法：可设为 2 或 3，发送一个需要多步工具调用的任务，即可触发“本次执行因额度限制停止”告警。
# 推荐值：生产建议 25~50（留空或未配置则默认取模式限额，如 standard 50）。
AGENT_MODEL_CALL_LIMIT_PER_RUN=50

# 【单个会话模型调用上限】整个会话（Thread / 多轮历史）累计允许调用大模型（LLM）的总次数。
# 作用：限制单一 Thread 长期膨胀消耗过量 Token，耗尽后提示用户开启新会话。
# 测试方法：可设为 3 或 5，在同一对话中连续发送多句指令，累计超限后触发“本会话累计调用额度已耗尽”并提示开启新对话。
# 推荐值：生产建议 200~500（留空或未配置则默认取模式限额，如 standard 500）。
AGENT_MODEL_CALL_LIMIT_PER_THREAD=500

# Optional invocation soft wrapup; unset/empty disables it. Must be finite and > 0.
# Example: AGENT_WRAPUP_AFTER_SECONDS=600. This is not the Worker's remaining time.
AGENT_WRAPUP_AFTER_SECONDS=
# Consecutive identical read batches: warn after 3, stop after 5. Strict 0/1; default off.
AGENT_LOOP_DETECTION_ENABLED=0

# 【会话上下文整理与卸载能力】开启后允许智能体进行会话上下文总结、压缩和手动卸载整理 (Conversation Offloading)。
# 作用：向网关和前端暴露 conversation_offloading 能力，允许用户或系统在上下文过长时触发整理。
# 默认值：1 (默认开启；设为 0 则关闭该能力)
AGENT_CONTEXT_MANAGEMENT_ENABLED=1

# ==============================================================================
# 沙箱执行模式与节点配置 (Sandbox Execution Backend & Target)
# ==============================================================================
# 【核心机制与三种工作模式切换指南】
# ------------------------------------------------------------------------------
# 模式 1：本地轻量原生进程模式 (Local Process Mode)
#   - 原理：Agent 工具调用与代码执行直接运行在当前操作系统的原生子进程中，不依赖任何 Docker。
#   - 适用：单机轻量测试、无 Docker 环境、低配开发机、快速调试 Agent 逻辑。
#   - 切换配置：
#       RUNTIME_BACKEND=local
#       RUNTIME_SANDBOX_TARGET=local
#
# 模式 2：本地 Docker 容器隔离模式 (Local Docker Sandbox Mode)
#   - 原理：Agent 任务在本地 Docker Desktop / Docker Daemon 中启动独立容器执行。
#   - 适用：本地具备 Docker 环境，需验证容器化环境隔离及依赖安装。
#   - 切换配置：
#       RUNTIME_BACKEND=docker
#       RUNTIME_SANDBOX_TARGET=local
#
# 模式 3：远端生产级 Docker 沙箱隔离模式 (Remote Docker Sandbox Mode)
#   - 原理：本地 Runtime 仅作为调度控制面，所有执行通过双向 mTLS + Bearer Token
#          委托给远端物理机/云服务器上的 runtime-sandbox-node 守护进程处理。
#          每个 Thread 按需创建/复用容器，空闲超时由 Reaper 自动销毁释放资源，
#          文件读写与 Zip 打包归档通过原生 HTTP 二进制流直接从宿主机卷直连传输。
#   - 适用：生产部署、跨服务器多租户隔离、避免消耗本地硬件资源。
#   - 切换配置：
#       RUNTIME_BACKEND=docker
#       RUNTIME_SANDBOX_TARGET=remote
#
# 【注意：local-stack.sh 启动时的行为】
#   执行 `bash scripts/local-stack.sh start` 时会自动 source 对应的 .env 文件。
#   - 若设置为 docker + remote，启动后即自动连接远端沙箱节点！
#   - 若想临时强制以本地模式启动，可使用命令行变量覆盖：
#     RUNTIME_BACKEND=local RUNTIME_SANDBOX_TARGET=local bash scripts/local-stack.sh restart
# ==============================================================================

# 执行后端类型：local (本地原生进程) | docker (Docker 容器沙箱)
RUNTIME_BACKEND=docker

# 沙箱调度目标：local (本地宿主机) | remote (远端独立沙箱节点)
RUNTIME_SANDBOX_TARGET=local

# ------------------------------------------------------------------------------
# 远端沙箱节点 (Remote Sandbox Node) 连接与 mTLS 安全凭据配置
# 【生效条件】：仅当 RUNTIME_BACKEND=docker 且 RUNTIME_SANDBOX_TARGET=remote 时生效
# ------------------------------------------------------------------------------

# 1. 调用方主机标识 (Caller Execution Host ID)
#    - 作用：向远端节点表明当前本地环境的身份。
#    - 约束：必须与凭据证书 client.pem 中的 Common Name (CN) 完全一致，
#            且必须已在远端节点的 /etc/runtime-sandbox/callers.json 白名单中登记。
RUNTIME_EXECUTION_HOST_ID=

# 2. 目标远端沙箱节点 ID (Remote Sandbox Node ID)
#    - 作用：指定要调度的远端节点实例名称。
#    - 约束：必须与远端节点 /etc/runtime-sandbox/node.env 中的 SANDBOX_NODE_ID 保持一致。
RUNTIME_SANDBOX_NODE_ID=sshmy2

# 3. 远端沙箱节点服务 URL (Remote Sandbox Node HTTPS Endpoint)
#    - 作用：Runtime Client 向远端节点下发指令、创建沙箱、执行命令与传输文件的 API 入口。
#    - 约束：必须为标准 https:// 格式，且带合法监听端口，严禁末尾携带 / 或 query 参数。
RUNTIME_SANDBOX_NODE_URL=

# 4. 【凭据一：调用方 Token 凭证文件】(Caller Bearer Token Path)
#    - 作用：应用层身份鉴权。发起 RPC 请求时以 Bearer Token 形式附带，远端节点校验其 SHA256 哈希值。
#    - 约束：必须为绝对路径，文件所属权必须安全，权限必须为 0600 (严禁 group/other 可读，严禁软链接)。
RUNTIME_SANDBOX_NODE_AUTH_FILE=

# 5. 【凭据二：沙箱信任域 CA 根证书】(Trust Domain Root CA Certificate Path)
#    - 作用：传输层服务端鉴权。客户端用此 CA 证书验证远端节点服务端证书 (server.pem) 的有效性，杜绝中间人攻击。
#    - 约束：必须为绝对路径，文件不可被非授权用户篡改。
RUNTIME_SANDBOX_NODE_CA_FILE=

# 6. 【凭据三：客户端 mTLS 身份公钥证书】(Client mTLS Certificate Path)
#    - 作用：双向 TLS 握手鉴权。在建立 TLS 链接时由本地出示给远端节点验证客户端合法性。
#    - 约束：必须为绝对路径，证书 Subject 必须包含 CN=<RUNTIME_EXECUTION_HOST_ID>。
RUNTIME_SANDBOX_NODE_CLIENT_CERT_FILE=

# 7. 【凭据四：客户端 mTLS 私钥】(Client mTLS Private Key Path)
#    - 作用：双向 TLS 握手签名。用于证明客户端持有对应 client.pem 的私钥。
#    - 约束：必须为绝对路径，权限必须为 0600 (严格禁止除当前用户外的任何人读取)。
RUNTIME_SANDBOX_NODE_CLIENT_KEY_FILE=

# 8. 沙箱容器镜像配置 (Sandbox Docker Container Images)
#    - 作用：远端 Docker 引擎拉起 Agent 独立沙箱时使用的标准基础镜像。
#    - 约束：该镜像必须已在远端节点的 Docker daemon 中存在，或可从配置的 Registry 自动拉取，
#            且必须在远端节点 /etc/runtime-sandbox/node.env 的 SANDBOX_ALLOWED_IMAGES 白名单中。
RUNTIME_WORKSPACE_IMAGE=runtime-agent-workspace:p5-v2
RUNTIME_SHOWCASE_IMAGE=runtime-agent-workspace:p5-v2

# ==============================================================================
# 知识库 / RAG 服务连接配置 (数据面: Agent 会话内 MCP 检索与受控文档入库)
# ==============================================================================
# 注意：知识库是双轨制架构！此处配置 Agent 会话中调用的 MCP 工具连接。
# 必须与 platform-api 的 PLATFORM_API_KNOWLEDGE_CONNECTIONS_JSON 保持相同 resource_id 与 scope！
#
# 【远端生产直连模式 (脱离 SSH 隧道)】
# 当远端 RAG 服务以独立域名或固定端口暴露时，直接在此处配置目标 URL（支持 http/https，如 https://rag.yourcompany.com/mcp）：
# RUNTIME_MCP_CONNECTIONS_JSON={"knowledge_alpha":{"url":"https://rag.yourcompany.com/mcp","headers":{"Authorization":"Bearer your-production-token-at-least-32-chars"},"scope":{"tenant_id":"__default","project_id":"your-project-uuid"},"transport":"streamable_http","allowed_tools":["mcp_query_project_knowledge","mcp_list_project_knowledge_documents","mcp_get_project_knowledge_document_status","mcp_submit_project_knowledge_document","mcp_get_project_knowledge_ingest_job"]}}
RUNTIME_MCP_CONNECTIONS_JSON={}

# 项目共享文档上传入库开关：1 开启，0 关闭（默认关闭；开启后 Agent 可调用 mcp_submit_project_knowledge_document）
RUNTIME_KNOWLEDGE_UPLOAD_ENABLED=0

# 知识库协议版本：1 为纯文本，2 支持精确页码与多模态定位 (默认 1，前端兼容后切 2)
RUNTIME_KNOWLEDGE_SOURCES_VERSION=1

# 平台与 RAG 间的操作签名凭据 (用于上传与任务流转时的 HMAC Grant 鉴权，必须 >= 32 字符)
RUNTIME_KNOWLEDGE_KEY_ID=knowledge-v1
RUNTIME_KNOWLEDGE_SECRET=

# 平台鉴权回调地址 (内部回调，指向 platform-api 的知识库授权接口)
# 生产环境下通常指向 platform-api 内部地址，如 http://127.0.0.1:2142/api/runtime/internal/knowledge/authorize
PLATFORM_KNOWLEDGE_AUTHORIZATION_URL=
