PLATFORM_API_APP_NAME=Platform API
PLATFORM_API_APP_VERSION=0.1.2
PLATFORM_API_APP_ENV=local
PLATFORM_API_API_DOCS_ENABLED=true
PLATFORM_API_CORS_ALLOW_ORIGINS=["http://localhost:3000"]

PLATFORM_API_LANGGRAPH_UPSTREAM_URL=http://127.0.0.1:8123
PLATFORM_API_LANGGRAPH_UPSTREAM_TIMEOUT_SECONDS=60
PLATFORM_API_LANGGRAPH_UPSTREAM_API_KEY=
PLATFORM_API_RUNTIME_DELEGATION_SECRET=local-runtime-delegation-secret-change-me-32
PLATFORM_API_RUNTIME_DELEGATION_KID=runtime-delegation-v1
PLATFORM_API_RUNTIME_DELEGATION_ISSUER=platform-api
PLATFORM_API_RUNTIME_DELEGATION_AUDIENCE=runtime-service
PLATFORM_API_RUNTIME_DELEGATION_TTL_SECONDS=60
PLATFORM_API_RUNTIME_COMPLETION_ENABLED=false
PLATFORM_API_RUNTIME_COMPLETION_KEY_ID=runtime-v1
PLATFORM_API_RUNTIME_COMPLETION_SECRET=
# JSON map of previous key IDs to secrets during rotation; all belong to the configured Runtime.
PLATFORM_API_RUNTIME_COMPLETION_VERIFICATION_KEYS={}
PLATFORM_API_MODEL_CONFIG_MASTER_KEY=
# Optional; falls back to the runtime delegation secret when omitted.
PLATFORM_API_RUNTIME_MODEL_CONFIG_SECRET=

PLATFORM_API_PLATFORM_DB_ENABLED=true
PLATFORM_API_PLATFORM_DB_AUTO_CREATE=false
PLATFORM_API_DATABASE_URL=postgresql+psycopg://platform_api:platform_api@127.0.0.1:5432/platform_api


PLATFORM_API_AUTH_REQUIRED=true
PLATFORM_API_JWT_ACCESS_SECRET=change-me-access-secret
PLATFORM_API_JWT_REFRESH_SECRET=change-me-refresh-secret
PLATFORM_API_BOOTSTRAP_ADMIN_ENABLED=true
PLATFORM_API_BOOTSTRAP_ADMIN_USERNAME=admin
PLATFORM_API_BOOTSTRAP_ADMIN_PASSWORD=admin123456
# ==============================================================================
# 知识库 / RAG 控制面与项目绑定配置 (控制面: Web 界面文档列表、任务进度、项目隔离)
# ==============================================================================
# 注意：知识库是双轨制架构！此处负责管理控制面（Web 界面查看文档列表、任务排队状态、MIME 检查）。
# 必须与 runtime-service 的 RUNTIME_MCP_CONNECTIONS_JSON 保持相同 resource_id 与 scope！
#
# 1. 项目绑定映射表：将项目 ID 映射到具体的知识资源 ID (tenant 默认 __default，project 使用对应项目 UUID)
# PLATFORM_KNOWLEDGE_MCP_BINDINGS_JSON={"__default:your-project-uuid":"knowledge_alpha"}
PLATFORM_KNOWLEDGE_MCP_BINDINGS_JSON={}

# 2. 知识库连接详情：配置远端 RAG 的 Base URL、认证 Token、Scope 与逻辑知识库 ID
# 【远端生产直连模式 (脱离 SSH 隧道)】
# 当远端以域名或固定 IP 暴露时，直接在此处填写目标地址（支持 http/https，如 https://rag.yourcompany.com）：
# PLATFORM_API_KNOWLEDGE_CONNECTIONS_JSON={"knowledge_alpha":{"base_url":"https://rag.yourcompany.com","token":"your-production-token-at-least-32-chars","scope":{"tenant_id":"__default","project_id":"your-project-uuid"},"knowledge_base_id":"kb_0123456789abcdef0123456789abcdef"}}
PLATFORM_API_KNOWLEDGE_CONNECTIONS_JSON={}

# 3. 控制面上传能力开关：开启后 Web 界面才会显示上传按钮与能力卡片 (true / false)
PLATFORM_API_KNOWLEDGE_UPLOAD_ENABLED=false

# 4. 平台与 RAG 间的操作签名凭据 (必须与 runtime-service 和 RAG 服务的配置完全一致，>= 32 字符)
PLATFORM_API_KNOWLEDGE_KEY_ID=knowledge-v1
PLATFORM_API_KNOWLEDGE_SECRET=
